# ==========================================
# FAUZI / JOURNAL - 100% FREE TIER CONFIG
# ==========================================

# 1. Clerk Authentication (Free Tier - 10.000 MAU)
# Dapatkan dari: https://dashboard.clerk.com -> Pilih App -> API Keys
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# 2. Database MySQL (TiDB Cloud Serverless - Gratis 25 GB Selamanya)
# Dapatkan dari: https://tidbcloud.com -> Create Serverless Cluster -> Connect
DATABASE_URL="mysql://<user>:<password>@<gateway-host>:4000/fauzi_journal?ssl={\"rejectUnauthorized\":true}"

# 3. Admin Account Role Designation
# Akun dengan email ini akan otomatis mendapatkan hak akses Administrator (melihat inquiries & subscribers)
ADMIN_EMAIL="fauzinoorsyabani@gmail.com"

# 4. Storage & Media (Vercel Blob - Free Tier 1 GB)
# Diisi otomatis oleh Vercel saat Anda mengklik "Create Blob Store" di dashboard Vercel
BLOB_READ_WRITE_TOKEN=""
VITE_PUBLIC_MEDIA_BASE_URL=""
